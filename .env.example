SECRET_KEY=
DATABASE_URL=
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Cloudinary (media storage)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Test Mode
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe CLI (local) or Dashboard (deployed)
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Current BDT-to-USD exchange rate (e.g. 120.50)
STRIPE_BDT_PER_USD=

# AI Search — Hybrid Retrieval Engine
AI_SEARCH_EMBEDDING_PROVIDER=gemini
AI_SEARCH_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_API_KEY=
AI_SEARCH_QUERY_CACHE_TTL=900
# Optional in production. Without this, Django uses an in-process local cache.
REDIS_URL=
# Dedicated disposable PostgreSQL database used only by automated tests.
AI_SEARCH_TEST_DATABASE_URL=
